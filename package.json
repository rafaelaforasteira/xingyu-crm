{
  "name": "xingyu-crm",
  "version": "0.1.0",
  "private": true,
  "description": "CRM web completo para gestão comercial, atendimento, pedidos, recompra, automações e operação da Xingyu.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @xingyu/web test:e2e",
    "db:generate": "pnpm --filter @xingyu/database generate",
    "db:migrate": "pnpm --filter @xingyu/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @xingyu/database migrate:deploy",
    "db:seed": "pnpm --filter @xingyu/database seed",
    "db:reset": "pnpm --filter @xingyu/database reset",
    "db:studio": "pnpm --filter @xingyu/database studio",
    "db:start": "pnpm --filter @xingyu/database start:local",
    "db:stop": "pnpm --filter @xingyu/database stop:local",
    "db:status": "node scripts/local.mjs status",
    "db:doctor": "node scripts/local.mjs doctor",
    "setup:local": "node scripts/local.mjs setup",
    "dev:local": "node scripts/local.mjs dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
