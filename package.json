{
  "name": "xingyu-crm",
  "version": "0.1.0",
  "private": true,
  "description": "CRM web completo para gestão comercial, atendimento, pedidos, recompra, automações e operação da Xingyu.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:api": "pnpm --filter @xingyu/api test",
    "test:web": "pnpm --filter @xingyu/web test",
    "test:coverage": "pnpm --filter @xingyu/api test:coverage",
    "test:e2e": "pnpm --filter @xingyu/web test:e2e",
    "test:load:helpers": "node --test tests/load/helpers/environment.test.mjs",
    "test:load:smoke": "node scripts/load-test.mjs smoke",
    "test:load:baseline": "node scripts/load-test.mjs baseline",
    "test:load:business": "node scripts/load-test.mjs business",
    "test:load:stress": "node scripts/load-test.mjs stress",
    "quality": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:load:helpers",
    "quality:full": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @xingyu/database generate",
    "db:migrate": "pnpm --filter @xingyu/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @xingyu/database migrate:deploy",
    "db:seed": "pnpm --filter @xingyu/database seed",
    "db:reset": "pnpm --filter @xingyu/database reset",
    "db:studio": "pnpm --filter @xingyu/database studio",
    "db:start": "pnpm --filter @xingyu/database start:local",
    "db:stop": "pnpm --filter @xingyu/database stop:local",
    "db:status": "node scripts/local.mjs status",
    "db:doctor": "node scripts/local.mjs doctor",
    "setup:local": "node scripts/local.mjs setup",
    "dev:local": "node scripts/local.mjs dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "body-parser@1": "1.20.9",
      "brace-expansion@1": "1.1.20",
      "brace-expansion@2": "2.1.6",
      "brace-expansion@5": "5.0.11",
      "fast-uri@3": "3.1.7",
      "glob@10": "10.5.0",
      "handlebars@4": "4.7.10",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "lodash@4": "4.18.0",
      "multer@2": "2.5.0",
      "nanoid@3": "3.3.18",
      "picomatch@4": "4.0.4",
      "postcss@8": "8.5.18",
      "proxy-addr@2": "2.0.8",
      "source-map-js@1": "1.2.2",
      "sharp@<0.35.5": "0.35.5",
      "deepmerge-ts@7": "8.0.0",
      "vite@<6.4.4": "6.4.4",
      "tmp@<0.2.7": "0.2.7"
    }
  }
}
