generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum AuthRole {
  ADMIN
  MANAGER
  CONSULTANT
}

enum GoalScope {
  ORGANIZATION
  TEAM
  USER
}

enum GoalMetric {
  REVENUE
  ORDERS
  NEW_CUSTOMERS
  REPEAT_CUSTOMERS
}

enum ChannelAccessMode {
  ORGANIZATION
  PIPELINE
  PERSONAL
}

/// Canonical CRM connection lifecycle (provider-specific states map into these).
enum ConnectionLifecycleStatus {
  DRAFT
  CONNECTING
  QR_PENDING
  CONNECTED
  RECONNECTING
  DISCONNECTED
  ERROR
  ARCHIVED
}

enum ContactStatus {
  LEAD
  QUALIFIED
  ACTIVE_CUSTOMER
  INACTIVE
  ARCHIVED
}

enum ContactType {
  RESELLER
  RETAILER
  WHOLESALER
  SITE_CUSTOMER
  WHATSAPP
  INSTAGRAM
  OTHER
}

enum DealStatus {
  OPEN
  WON
  LOST
  ARCHIVED
}

enum DealPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PipelineStageType {
  OPEN
  WON
  LOST
}

enum PipelineAccessMode {
  ORGANIZATION
  RESTRICTED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskStatusCategory {
  OPEN
  IN_PROGRESS
  DONE
}

enum TaskType {
  CALL
  WHATSAPP
  FOLLOW_UP
  COLLECTION
  SEND_CATALOG
  SEND_LINK
  PAYMENT
  MEETING
  MONITORING
  AFTER_SALES
  REPURCHASE
  INTERNAL
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  SITE_CHAT
  WEB_CHAT
  EMAIL
  SHOPIFY
  FORM
  WEBHOOK
  MANUAL
}

enum PipelineDuplicateStrategy {
  MERGE
  CREATE_NEW
  REJECT
}

enum PipelineRoutingMode {
  PIPELINE_DEFAULTS
  FIXED
  ROUND_ROBIN
}

enum OrderStatus {
  ORDER_PLACED
  AWAITING_PAYMENT
  PAYMENT_APPROVED
  SEPARATING
  IN_PRODUCTION
  LEFT_FACTORY
  INTERNATIONAL_TRANSPORT
  ARRIVED_BRAZIL
  NATIONAL_TRANSPORT
  DELIVERED
  AFTER_SALES_STARTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  OVERDUE
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO
  BANK_TRANSFER
  CASH
  OTHER
}

enum ShipmentStatus {
  PENDING
  IN_PRODUCTION
  INTERNATIONAL_TRANSPORT
  IN_BRAZIL
  NATIONAL_TRANSPORT
  DELIVERED
  DELAYED
  RETURNED
}

enum OrderStageCategory {
  OPEN
  IN_PROGRESS
  DONE
  ISSUE
}

enum OccurrenceType {
  DEFECT
  MISSING_PRODUCT
  DIVERGENCE
  DELAY
  DAMAGED_PACKAGING
  WRONG_ORDER
  RETURN
  RECALL
  REFUND
  CREDIT
  GENERAL_COMPLAINT
}

enum OccurrenceStatus {
  OPEN
  AWAITING_FILES
  UNDER_REVIEW
  AWAITING_CUSTOMER
  AWAITING_DEPARTMENT
  APPROVED
  REJECTED
  RESOLVED
  CLOSED
}

enum AutomationStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum NotificationType {
  UNANSWERED_LEAD
  OVERDUE_TASK
  PENDING_PAYMENT
  STALLED_DEAL
  DELAYED_ORDER
  OPEN_OCCURRENCE
  REPURCHASE_READY
  AUTOMATION_ERROR
  SYSTEM
  TASK_MENTION
}

enum CustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  CURRENCY
  PERCENT
  DATE
  TIME
  BOOLEAN
  SELECT
  MULTI_SELECT
  PHONE
  EMAIL
  URL
}

enum EntityType {
  CONTACT
  COMPANY
  DEAL
  ORDER
  OCCURRENCE
  TASK
}

enum ActivityType {
  CONTACT_CREATED
  CONTACT_UPDATED
  OWNER_CHANGED
  STAGE_CHANGED
  MESSAGE_SENT
  MESSAGE_RECEIVED
  DEAL_CREATED
  TASK_CREATED
  TASK_COMPLETED
  TASK_REOPENED
  FILE_SAVED
  FILE_REMOVED
  ORDER_CREATED
  PAYMENT_APPROVED
  ORDER_SHIPPED
  ORDER_DELIVERED
  TAG_ADDED
  NOTE_CREATED
  OCCURRENCE_OPENED
  OCCURRENCE_CLOSED
  OTHER
}

enum LifecycleKind {
  REACTIVATION
  REPURCHASE
}

enum LifecycleActionType {
  APPROACHED
  POSTPONED
  DISCARDED
  CONVERTED
}

model Organization {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  timezone         String    @default("America/Sao_Paulo")
  currency         String    @default("BRL")
  nextLeadSequence Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  users                      User[]
  teams                      Team[]
  roles                      Role[]
  contacts                   Contact[]
  companies                  Company[]
  pipelines                  Pipeline[]
  deals                      Deal[]
  tasks                      Task[]
  activities                 Activity[]
  notes                      Note[]
  tags                       Tag[]
  customFields               CustomFieldDefinition[]
  conversations              Conversation[]
  channels                   Channel[]
  pipelineChannelConnections PipelineChannelConnection[]
  channelTeamAccesses        ChannelTeamAccess[]
  channelUserAccesses        ChannelUserAccess[]
  providerEventReceipts      ProviderEventReceipt[]
  pipelineTeamAccesses       PipelineTeamAccess[]
  pipelineUserAccesses       PipelineUserAccess[]
  orders                     Order[]
  products                   Product[]
  collections                ProductCollection[]
  occurrences                Occurrence[]
  campaigns                  Campaign[]
  automations                Automation[]
  notifications              Notification[]
  savedViews                 SavedView[]
  auditLogs                  AuditLog[]
  attributions               Attribution[]
  lifecycleActions           LifecycleAction[]
  taskStatusDefinitions      TaskStatusDefinition[]
  leadFiles                  LeadFile[]
  userInvites                UserInvite[]
  goals                      Goal[]
  orderStageDefinitions      OrderStageDefinition[]
  taskComments               TaskComment[]
  taskCommentMentions        TaskCommentMention[]
  taskCommentAttachments     TaskCommentAttachment[]
}

model Role {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  permissions    Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Team {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization               Organization                @relation(fields: [organizationId], references: [id])
  members                    User[]
  contacts                   Contact[]
  deals                      Deal[]
  tasks                      Task[]
  defaultPipelines           Pipeline[]                  @relation("PipelineDefaultTeam")
  pipelineChannelConnections PipelineChannelConnection[] @relation("PipelineChannelDefaultTeam")
  pipelineAccesses           PipelineTeamAccess[]
  channelAccesses            ChannelTeamAccess[]
  goals                      Goal[]

  @@index([organizationId])
}

model User {
  id             String     @id @default(cuid())
  organizationId String
  teamId         String?
  roleId         String?
  managerId      String?
  name           String
  email          String
  phone          String?
  avatarUrl      String?
  title          String?
  locale         String     @default("pt-BR")
  timezone       String     @default("America/Sao_Paulo")
  /// Authentication role for homologation RBAC foundation (distinct from CRM Role relation).
  authRole       AuthRole   @default(CONSULTANT)
  passwordHash   String?
  status         UserStatus @default(ACTIVE)
  monthlyGoal    Decimal?   @db.Decimal(12, 2)
  lastLoginAt    DateTime?
  /// Set when an admin deactivates the user; drives the 90-day soft-archive policy.
  deactivatedAt  DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  team         Team?         @relation(fields: [teamId], references: [id])
  role         Role?         @relation(fields: [roleId], references: [id])
  manager      User?         @relation("UserManager", fields: [managerId], references: [id])
  reports      User[]        @relation("UserManager")
  sessions     UserSession[]

  ownedContacts              Contact[]                   @relation("ContactOwner")
  ownedCompanies             Company[]                   @relation("CompanyOwner")
  ownedDeals                 Deal[]                      @relation("DealOwner")
  assignedTasks              Task[]                      @relation("TaskAssignee")
  createdTasks               Task[]                      @relation("TaskCreator")
  taskComments               TaskComment[]               @relation("TaskCommentAuthor")
  taskCommentMentions        TaskCommentMention[]
  assignedConversations      Conversation[]              @relation("ConversationAssignee")
  sentMessages               Message[]                   @relation("MessageSender")
  ownedOrders                Order[]                     @relation("OrderOwner")
  operationalOrders          Order[]                     @relation("OrderOperationalAssignee")
  ownedOccurrences           Occurrence[]                @relation("OccurrenceOwner")
  notifications              Notification[]
  activities                 Activity[]                  @relation("ActivityActor")
  notes                      Note[]
  auditLogs                  AuditLog[]
  defaultPipelines           Pipeline[]                  @relation("PipelineDefaultOwner")
  pipelineChannelConnections PipelineChannelConnection[] @relation("PipelineChannelDefaultOwner")
  lifecycleActions           LifecycleAction[]           @relation("LifecycleActionActor")
  savedLeadFiles             LeadFile[]                  @relation("LeadFileSavedBy")
  pipelineAccesses           PipelineUserAccess[]
  channelOwnerships          Channel[]                   @relation("ChannelOwner")
  channelAccesses            ChannelUserAccess[]         @relation("ChannelUserAccess")
  invites                    UserInvite[]                @relation("InvitedUser")
  createdInvites             UserInvite[]                @relation("InviteCreator")
  goals                      Goal[]                      @relation("GoalTargetUser")
  createdGoals               Goal[]                      @relation("GoalCreatedBy")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([teamId])
  @@index([status])
  @@index([email])
  @@index([authRole])
}

model Goal {
  id              String     @id @default(cuid())
  organizationId  String
  metric          GoalMetric
  scope           GoalScope
  teamId          String?
  userId          String?
  pipelineId      String?
  targetValue     Decimal    @db.Decimal(14, 2)
  periodStart     DateTime
  periodEnd       DateTime
  createdByUserId String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  archivedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: Restrict)
  user         User?        @relation("GoalTargetUser", fields: [userId], references: [id], onDelete: Restrict)
  pipeline     Pipeline?    @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("GoalCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, periodStart, periodEnd])
  @@index([organizationId, scope, metric])
  @@index([teamId])
  @@index([userId])
  @@index([pipelineId])
}

model UserInvite {
  id              String    @id @default(cuid())
  organizationId  String
  userId          String
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("InvitedUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("InviteCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId])
  @@index([userId, usedAt, revokedAt])
  @@index([expiresAt])
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Company {
  id             String    @id @default(cuid())
  organizationId String
  ownerId        String?
  legalName      String
  tradeName      String?
  cnpj           String?
  segment        String?
  phone          String?
  email          String?
  instagram      String?
  website        String?
  address        String?
  city           String?
  state          String?
  country        String?   @default("Brasil")
  status         String    @default("ACTIVE")
  totalPurchased Decimal   @default(0) @db.Decimal(14, 2)
  averageTicket  Decimal   @default(0) @db.Decimal(14, 2)
  lastPurchaseAt DateTime?
  observations   String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  owner        User?        @relation("CompanyOwner", fields: [ownerId], references: [id])
  contacts     Contact[]
  deals        Deal[]
  orders       Order[]
  occurrences  Occurrence[]
  activities   Activity[]
  notes        Note[]
  tasks        Task[]

  @@index([organizationId])
  @@index([cnpj])
  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@index([lastPurchaseAt])
}

model Contact {
  id                  String        @id @default(cuid())
  organizationId      String
  companyId           String?
  ownerId             String?
  teamId              String?
  firstName           String
  lastName            String?
  phone               String?
  whatsapp            String?
  email               String?
  instagram           String?
  city                String?
  state               String?
  country             String?       @default("Brasil")
  cnpj                String?
  cpf                 String?
  type                ContactType   @default(OTHER)
  status              ContactStatus @default(LEAD)
  source              String?
  campaign            String?
  observations        String?
  firstInteractionAt  DateTime?
  firstPurchaseAt     DateTime?
  lastPurchaseAt      DateTime?
  totalPurchased      Decimal       @default(0) @db.Decimal(14, 2)
  averageTicket       Decimal       @default(0) @db.Decimal(14, 2)
  orderCount          Int           @default(0)
  daysWithoutPurchase Int?
  nextContactAt       DateTime?
  createdById         String?
  updatedById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  organization     Organization       @relation(fields: [organizationId], references: [id])
  company          Company?           @relation(fields: [companyId], references: [id])
  owner            User?              @relation("ContactOwner", fields: [ownerId], references: [id])
  team             Team?              @relation(fields: [teamId], references: [id])
  tags             ContactTag[]
  deals            Deal[]
  tasks            Task[]
  conversations    Conversation[]
  orders           Order[]
  occurrences      Occurrence[]
  activities       Activity[]
  notes            Note[]
  attributions     Attribution[]
  customValues     CustomFieldValue[]
  lifecycleActions LifecycleAction[]

  @@index([organizationId])
  @@index([phone])
  @@index([email])
  @@index([instagram])
  @@index([cnpj])
  @@index([cpf])
  @@index([status])
  @@index([ownerId])
  @@index([teamId])
  @@index([createdAt])
  @@index([lastPurchaseAt])
  @@index([companyId])
}

model Pipeline {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  description    String?
  color          String?            @default("#7C3AED")
  icon           String?
  isDefault      Boolean            @default(false)
  favorite       Boolean            @default(false)
  position       Int                @default(0)
  archived       Boolean            @default(false)
  accessMode     PipelineAccessMode @default(ORGANIZATION)
  defaultTeamId  String?
  defaultOwnerId String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  organization       Organization                @relation(fields: [organizationId], references: [id])
  defaultTeam        Team?                       @relation("PipelineDefaultTeam", fields: [defaultTeamId], references: [id], onDelete: SetNull)
  defaultOwner       User?                       @relation("PipelineDefaultOwner", fields: [defaultOwnerId], references: [id], onDelete: SetNull)
  stages             PipelineStage[]
  deals              Deal[]
  tasks              Task[]
  channelConnections PipelineChannelConnection[]
  teamAccesses       PipelineTeamAccess[]
  userAccesses       PipelineUserAccess[]
  goals              Goal[]

  @@index([organizationId])
  @@index([archived])
  @@index([defaultTeamId])
  @@index([defaultOwnerId])
  @@index([organizationId, deletedAt, archived, favorite])
}

model PipelineTeamAccess {
  id             String   @id @default(cuid())
  organizationId String
  pipelineId     String
  teamId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, teamId])
  @@index([organizationId, teamId])
  @@index([organizationId, pipelineId])
}

model PipelineUserAccess {
  id             String   @id @default(cuid())
  organizationId String
  pipelineId     String
  userId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, userId])
  @@index([organizationId, userId])
  @@index([organizationId, pipelineId])
}

model PipelineStage {
  id                 String            @id @default(cuid())
  organizationId     String
  pipelineId         String
  name               String
  description        String?
  color              String?           @default("#A78BFA")
  position           Int               @default(0)
  type               PipelineStageType @default(OPEN)
  isInitial          Boolean           @default(false)
  maxDurationMinutes Int?
  probability        Int?
  archived           Boolean           @default(false)
  isWon              Boolean           @default(false)
  isLost             Boolean           @default(false)
  maxDaysInStage     Int?
  rules              Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  pipeline                   Pipeline                    @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals                      Deal[]
  tasks                      Task[]
  history                    DealStageHistory[]
  pipelineChannelConnections PipelineChannelConnection[] @relation("PipelineChannelDefaultStage")

  @@index([pipelineId])
  @@index([organizationId])
  @@index([position])
  @@index([pipelineId, deletedAt, archived, position])
  @@index([pipelineId, type])
}

model Deal {
  id                String       @id @default(cuid())
  organizationId    String
  pipelineId        String
  stageId           String
  contactId         String?
  companyId         String?
  ownerId           String?
  teamId            String?
  conversationId    String?      @unique
  name              String
  leadSequence      Int?
  value             Decimal      @default(0) @db.Decimal(14, 2)
  status            DealStatus   @default(OPEN)
  priority          DealPriority @default(MEDIUM)
  source            String?
  campaign          String?
  lostReason        String?
  enteredStageAt    DateTime     @default(now())
  closedAt          DateTime?
  nextTaskAt        DateTime?
  lastInteractionAt DateTime?
  unreadMessages    Int          @default(0)
  createdById       String?
  updatedById       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  organization    Organization       @relation(fields: [organizationId], references: [id])
  pipeline        Pipeline           @relation(fields: [pipelineId], references: [id])
  stage           PipelineStage      @relation(fields: [stageId], references: [id])
  contact         Contact?           @relation(fields: [contactId], references: [id])
  company         Company?           @relation(fields: [companyId], references: [id])
  owner           User?              @relation("DealOwner", fields: [ownerId], references: [id])
  team            Team?              @relation(fields: [teamId], references: [id])
  conversation    Conversation?      @relation(fields: [conversationId], references: [id])
  tags            DealTag[]
  stageHistory    DealStageHistory[]
  tasks           Task[]
  orders          Order[]
  activities      Activity[]
  notes           Note[]
  customValues    CustomFieldValue[]
  lifecycleAction LifecycleAction?
  leadFiles       LeadFile[]

  @@unique([organizationId, leadSequence])
  @@index([organizationId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([contactId])
  @@index([ownerId])
  @@index([teamId])
  @@index([status])
  @@index([createdAt])
  @@index([lastInteractionAt])
}

model DealStageHistory {
  id          String   @id @default(cuid())
  dealId      String
  stageId     String
  fromStageId String?
  movedById   String?
  movedAt     DateTime @default(now())
  note        String?

  deal  Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  stage PipelineStage @relation(fields: [stageId], references: [id])

  @@index([dealId])
  @@index([stageId])
  @@index([movedAt])
}

model TaskStatusDefinition {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  slug           String
  color          String             @default("#64748B")
  position       Int                @default(0)
  category       TaskStatusCategory @default(OPEN)
  active         Boolean            @default(true)
  archived       Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  tasks        Task[]

  @@unique([organizationId, slug])
  @@index([organizationId, active, position])
}

model Task {
  id                 String       @id @default(cuid())
  organizationId     String
  title              String
  description        String?
  type               TaskType     @default(FOLLOW_UP)
  status             TaskStatus   @default(PENDING)
  statusDefinitionId String?
  priority           TaskPriority @default(MEDIUM)
  dueAt              DateTime?
  reminderAt         DateTime?
  completedAt        DateTime?
  result             String?
  completionNote     String?
  recurrenceRule     String?
  assigneeId         String?
  createdById        String?
  updatedById        String?
  contactId          String?
  companyId          String?
  dealId             String?
  pipelineId         String?
  stageId            String?
  orderId            String?
  occurrenceId       String?
  sourceNoteId       String?
  teamId             String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  organization     Organization          @relation(fields: [organizationId], references: [id])
  statusDefinition TaskStatusDefinition? @relation(fields: [statusDefinitionId], references: [id], onDelete: SetNull)
  assignee         User?                 @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator          User?                 @relation("TaskCreator", fields: [createdById], references: [id])
  contact          Contact?              @relation(fields: [contactId], references: [id])
  company          Company?              @relation(fields: [companyId], references: [id])
  deal             Deal?                 @relation(fields: [dealId], references: [id])
  pipeline         Pipeline?             @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stage            PipelineStage?        @relation(fields: [stageId], references: [id], onDelete: SetNull)
  order            Order?                @relation(fields: [orderId], references: [id])
  occurrence       Occurrence?           @relation(fields: [occurrenceId], references: [id])
  sourceNote       Note?                 @relation(fields: [sourceNoteId], references: [id], onDelete: SetNull)
  team             Team?                 @relation(fields: [teamId], references: [id])
  activities       Activity[]
  comments         TaskComment[]

  @@index([organizationId])
  @@index([assigneeId])
  @@index([sourceNoteId])
  @@index([status])
  @@index([statusDefinitionId])
  @@index([dueAt])
  @@index([contactId])
  @@index([dealId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([createdAt])
}

model TaskComment {
  id             String    @id @default(cuid())
  organizationId String
  taskId         String
  authorId       String
  body           String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization            @relation(fields: [organizationId], references: [id])
  task         Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author       User                    @relation("TaskCommentAuthor", fields: [authorId], references: [id])
  mentions     TaskCommentMention[]
  attachments  TaskCommentAttachment[]

  @@index([organizationId, taskId, createdAt])
}

model TaskCommentMention {
  id             String   @id @default(cuid())
  organizationId String
  commentId      String
  userId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  comment      TaskComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([organizationId, userId, createdAt])
}

model TaskCommentAttachment {
  id             String   @id @default(cuid())
  organizationId String
  commentId      String
  fileName       String
  mimeType       String?
  fileSize       Int?
  url            String
  kind           String   @default("file")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  comment      TaskComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([organizationId, commentId])
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  type           ActivityType
  title          String
  description    String?
  metadata       Json?
  actorId        String?
  contactId      String?
  companyId      String?
  dealId         String?
  orderId        String?
  taskId         String?
  occurrenceId   String?
  conversationId String?
  createdAt      DateTime     @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  actor        User?         @relation("ActivityActor", fields: [actorId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id])
  company      Company?      @relation(fields: [companyId], references: [id])
  deal         Deal?         @relation(fields: [dealId], references: [id])
  order        Order?        @relation(fields: [orderId], references: [id])
  task         Task?         @relation(fields: [taskId], references: [id])
  occurrence   Occurrence?   @relation(fields: [occurrenceId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([organizationId])
  @@index([contactId])
  @@index([dealId])
  @@index([organizationId, dealId, createdAt(sort: Desc)], map: "Activity_deal_timeline_idx")
  @@index([orderId])
  @@index([createdAt])
  @@index([type])
}

model LifecycleAction {
  id             String              @id @default(cuid())
  organizationId String
  contactId      String
  actorId        String?
  kind           LifecycleKind
  action         LifecycleActionType
  reason         String?
  snoozedUntil   DateTime?
  dealId         String?             @unique
  conversationId String?
  metadata       Json?
  createdAt      DateTime            @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  actor        User?         @relation("LifecycleActionActor", fields: [actorId], references: [id], onDelete: Restrict)
  deal         Deal?         @relation(fields: [dealId], references: [id], onDelete: Restrict)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@index([organizationId, contactId, kind, createdAt], map: "LifecycleAction_latest_idx")
  @@index([organizationId, kind, action, snoozedUntil], map: "LifecycleAction_queue_idx")
  @@index([conversationId], map: "LifecycleAction_conversationId_idx")
}

model Note {
  id             String    @id @default(cuid())
  organizationId String
  content        String
  isInternal     Boolean   @default(true)
  authorId       String?
  contactId      String?
  companyId      String?
  dealId         String?
  orderId        String?
  occurrenceId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id])
  author         User?        @relation(fields: [authorId], references: [id])
  contact        Contact?     @relation(fields: [contactId], references: [id])
  company        Company?     @relation(fields: [companyId], references: [id])
  deal           Deal?        @relation(fields: [dealId], references: [id])
  order          Order?       @relation(fields: [orderId], references: [id])
  occurrence     Occurrence?  @relation(fields: [occurrenceId], references: [id])
  generatedTasks Task[]

  @@index([organizationId])
  @@index([contactId])
  @@index([dealId])
  @@index([organizationId, dealId, createdAt])
}

model Tag {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  color          String     @default("#7C3AED")
  description    String?
  entityType     EntityType @default(CONTACT)
  status         String     @default("ACTIVE")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  contacts     ContactTag[]
  deals        DealTag[]

  @@unique([organizationId, name, entityType])
  @@index([organizationId])
}

model ContactTag {
  contactId String
  tagId     String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model DealTag {
  dealId    String
  tagId     String
  createdAt DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dealId, tagId])
}

model CustomFieldDefinition {
  id             String          @id @default(cuid())
  organizationId String
  entityType     EntityType
  name           String
  key            String
  fieldType      CustomFieldType
  options        Json?
  required       Boolean         @default(false)
  position       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id])
  values       CustomFieldValue[]

  @@unique([organizationId, entityType, key])
  @@index([organizationId, entityType])
}

model CustomFieldValue {
  id          String   @id @default(cuid())
  fieldId     String
  contactId   String?
  companyId   String?
  dealId      String?
  orderId     String?
  valueText   String?
  valueNumber Decimal? @db.Decimal(14, 4)
  valueBool   Boolean?
  valueJson   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  field   CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  contact Contact?              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal    Deal?                 @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([fieldId])
  @@index([contactId])
  @@index([dealId])
}

model Channel {
  id                String                     @id @default(cuid())
  organizationId    String
  type              ChannelType
  name              String
  provider          String?
  externalAccountId String?
  displayName       String?
  /// Human-readable account identity (e.g. formatted WhatsApp phone).
  displayAccount    String?
  /// Legacy compatibility flag (ACTIVE / INACTIVE). Prefer lifecycleStatus.
  status            String                     @default("ACTIVE")
  lifecycleStatus   ConnectionLifecycleStatus  @default(DRAFT)
  isActive          Boolean                    @default(true)
  configurationComplete Boolean                @default(false)
  /// Non-sensitive account configuration. Credentials must be referenced by
  /// secretReference and never persisted in this JSON field.
  config            Json?
  secretReference   String?
  connectedAt       DateTime?
  disconnectedAt    DateTime?
  lastActivityAt    DateTime?
  lastInboundAt     DateTime?
  lastOutboundAt    DateTime?
  lastSyncAt        DateTime?
  lastErrorAt       DateTime?
  lastErrorCode     String?
  lastErrorMessage  String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  deletedAt         DateTime?
  archivedAt        DateTime?
  accessMode        ChannelAccessMode          @default(ORGANIZATION)
  ownerUserId       String?

  organization        Organization                @relation(fields: [organizationId], references: [id])
  conversations       Conversation[]
  messages            Message[]
  pipelineConnections PipelineChannelConnection[]
  teamAccesses        ChannelTeamAccess[]
  userAccesses        ChannelUserAccess[]
  providerEvents      ProviderEventReceipt[]
  owner               User?                       @relation("ChannelOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([type])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, lifecycleStatus, archivedAt, deletedAt])
  @@index([organizationId, provider, externalAccountId])
  @@index([organizationId, accessMode, ownerUserId])
}

/// Routes one existing Channel integration account into one pipeline. Channel
/// deliberately serves as IntegrationAccount so credentials and provider state
/// are not duplicated across CRM domains.
model PipelineChannelConnection {
  id                 String                    @id @default(cuid())
  organizationId     String
  pipelineId         String
  channelId          String
  /// At most one active default route per channel (enforced in service).
  isDefault          Boolean                   @default(false)
  defaultStageId     String?
  defaultOwnerId     String?
  defaultTeamId      String?
  defaultTagIds      Json                      @default("[]")
  source             String?
  campaignId         String?
  active             Boolean                   @default(true)
  createContact      Boolean                   @default(true)
  createConversation Boolean                   @default(true)
  createDeal         Boolean                   @default(true)
  duplicateStrategy  PipelineDuplicateStrategy @default(MERGE)
  routingMode        PipelineRoutingMode       @default(PIPELINE_DEFAULTS)
  /// Reserved for future rule engines (priority / condition JSON).
  priority           Int                       @default(100)
  condition          Json?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  deletedAt          DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  channel      Channel        @relation(fields: [channelId], references: [id], onDelete: Restrict)
  defaultStage PipelineStage? @relation("PipelineChannelDefaultStage", fields: [defaultStageId], references: [id], onDelete: SetNull)
  defaultOwner User?          @relation("PipelineChannelDefaultOwner", fields: [defaultOwnerId], references: [id], onDelete: SetNull)
  defaultTeam  Team?          @relation("PipelineChannelDefaultTeam", fields: [defaultTeamId], references: [id], onDelete: SetNull)
  campaign     Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([pipelineId, deletedAt, active])
  @@index([channelId, deletedAt, active])
  @@index([channelId, isDefault, deletedAt])
  @@index([defaultStageId])
  @@index([defaultOwnerId])
  @@index([defaultTeamId])
  @@index([campaignId])
}

/// Teams allowed to operate a connection (view/reply). Admin always may administer.
model ChannelTeamAccess {
  id             String   @id @default(cuid())
  organizationId String
  channelId      String
  teamId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([channelId, teamId])
  @@index([organizationId])
  @@index([teamId])
}

/// Optional per-user connection access grants (same organization only).
model ChannelUserAccess {
  id             String   @id @default(cuid())
  organizationId String
  channelId      String
  userId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user         User         @relation("ChannelUserAccess", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([organizationId])
  @@index([userId])
}

/// Idempotent receipt of provider webhooks / events.
model ProviderEventReceipt {
  id                String   @id @default(cuid())
  organizationId    String
  channelId         String
  externalEventId   String
  externalMessageId String?
  processedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalEventId])
  @@index([organizationId])
  @@index([channelId, externalMessageId])
}

model Conversation {
  id             String             @id @default(cuid())
  organizationId String
  contactId      String?
  channelId      String?
  assigneeId     String?
  subject        String?
  status         ConversationStatus @default(OPEN)
  lastMessageAt  DateTime?
  unreadCount    Int                @default(0)
  createdById    String?
  updatedById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  organization     Organization      @relation(fields: [organizationId], references: [id])
  contact          Contact?          @relation(fields: [contactId], references: [id])
  channel          Channel?          @relation(fields: [channelId], references: [id])
  assignee         User?             @relation("ConversationAssignee", fields: [assigneeId], references: [id])
  messages         Message[]
  deal             Deal?
  activities       Activity[]
  lifecycleActions LifecycleAction[]
  leadFiles        LeadFile[]

  @@index([organizationId])
  @@index([contactId])
  @@index([assigneeId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([organizationId, lastMessageAt])
  @@index([organizationId, channelId, lastMessageAt])
  @@index([organizationId, assigneeId, status])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  channelId      String?
  senderId       String?
  direction      MessageDirection
  status         MessageStatus    @default(SENT)
  body           String?
  isInternal     Boolean          @default(false)
  metadata       Json?
  sentAt         DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel      Channel?            @relation(fields: [channelId], references: [id])
  sender       User?               @relation("MessageSender", fields: [senderId], references: [id])
  attachments  MessageAttachment[]
  leadFiles    LeadFile[]

  @@index([conversationId])
  @@index([sentAt])
  @@index([direction])
  @@index([conversationId, sentAt])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  fileName  String
  mimeType  String?
  fileSize  Int?
  url       String
  kind      String   @default("file")
  createdAt DateTime @default(now())

  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  leadFiles LeadFile[]

  @@index([messageId])
}

model LeadFile {
  id               String            @id @default(cuid())
  organizationId   String
  dealId           String
  conversationId   String?
  messageId        String?
  attachmentId     String?
  savedById        String?
  fileName         String
  mimeType         String?
  fileSize         Int?
  url              String
  kind             String
  messageDirection MessageDirection?
  messageCreatedAt DateTime?
  savedAt          DateTime          @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id])
  deal         Deal               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  conversation Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      Message?           @relation(fields: [messageId], references: [id], onDelete: SetNull)
  attachment   MessageAttachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  savedBy      User?              @relation("LeadFileSavedBy", fields: [savedById], references: [id], onDelete: SetNull)

  @@unique([dealId, attachmentId])
  @@index([organizationId, dealId, savedAt])
  @@index([messageId])
  @@index([attachmentId])
}

model ProductCollection {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  season         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  products     Product[]

  @@index([organizationId])
}

model Product {
  id             String    @id @default(cuid())
  organizationId String
  collectionId   String?
  name           String
  sku            String
  description    String?
  price          Decimal   @db.Decimal(12, 2)
  imageUrl       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id])
  collection   ProductCollection? @relation(fields: [collectionId], references: [id])
  orderItems   OrderItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([collectionId])
}

model Order {
  id                       String       @id @default(cuid())
  organizationId           String
  number                   String
  contactId                String?
  companyId                String?
  ownerId                  String?
  dealId                   String?
  operationalStageId       String?
  operationalAssigneeId    String?
  operationalPriority      TaskPriority @default(MEDIUM)
  operationalDueAt         DateTime?
  operationalIssue         Boolean      @default(false)
  fulfillmentStatus        String?
  currentLocation          String?
  channel                  String?
  source                   String?
  campaign                 String?
  currency                 String       @default("BRL")
  externalId               String?
  externalName             String?
  externalUrl              String?
  customerOrderStatusUrl   String?
  financialStatus          String?
  paymentGateway           String?
  customerNameSnapshot     String?
  customerEmailSnapshot    String?
  customerPhoneSnapshot    String?
  recipientNameSnapshot    String?
  address1Snapshot         String?
  address2Snapshot         String?
  addressNumberSnapshot    String?
  complementSnapshot       String?
  neighborhoodSnapshot     String?
  citySnapshot             String?
  provinceSnapshot         String?
  postalCodeSnapshot       String?
  countrySnapshot          String?
  countryCodeSnapshot      String?
  formattedAddressSnapshot String?
  isFirstPurchase          Boolean?
  purchaseOrdinal          Int?
  trackingSourceSnapshot   String?
  trackingMediumSnapshot   String?
  trackingCampaignSnapshot String?
  trackingContentSnapshot  String?
  trackingTermSnapshot     String?
  landingPageSnapshot      String?
  referrerSnapshot         String?
  orderedAt                DateTime     @default(now())
  grossValue               Decimal      @default(0) @db.Decimal(14, 2)
  discount                 Decimal      @default(0) @db.Decimal(14, 2)
  coupon                   String?
  shippingCost             Decimal      @default(0) @db.Decimal(14, 2)
  taxes                    Decimal      @default(0) @db.Decimal(14, 2)
  finalValue               Decimal      @default(0) @db.Decimal(14, 2)
  status                   OrderStatus  @default(ORDER_PLACED)
  expectedAt               DateTime?
  trackingCode             String?
  observations             String?
  createdById              String?
  updatedById              String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  deletedAt                DateTime?

  organization        Organization          @relation(fields: [organizationId], references: [id])
  contact             Contact?              @relation(fields: [contactId], references: [id])
  company             Company?              @relation(fields: [companyId], references: [id])
  owner               User?                 @relation("OrderOwner", fields: [ownerId], references: [id])
  deal                Deal?                 @relation(fields: [dealId], references: [id])
  operationalStage    OrderStageDefinition? @relation(fields: [operationalStageId], references: [id], onDelete: SetNull)
  operationalAssignee User?                 @relation("OrderOperationalAssignee", fields: [operationalAssigneeId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payments            Payment[]
  shipments           Shipment[]
  occurrences         Occurrence[]
  tasks               Task[]
  activities          Activity[]
  notes               Note[]
  attributions        Attribution[]
  events              OrderEvent[]

