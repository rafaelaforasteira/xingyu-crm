  @@index([contactId])
  @@index([status])
  @@index([orderedAt])
  @@index([ownerId])
  @@index([contactId, orderedAt])
  @@index([organizationId, externalId])
  @@index([organizationId, operationalStageId])
  @@index([organizationId, operationalAssigneeId])
  @@index([organizationId, operationalDueAt])
