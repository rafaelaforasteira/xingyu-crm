  orderId      String
  carrier      String?
  trackingCode String?
  trackingIssuedAt DateTime?
  shippingLabelUrl String?
  commercialInvoiceUrl String?
  origin       String?
  destination  String?
  status       ShipmentStatus @default(PENDING)
  postedAt     DateTime?
  expectedAt   DateTime?
  deliveredAt  DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events ShipmentEvent[]

  @@index([orderId])
  @@index([status])
  @@index([trackingCode])
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  status      String
  description String?
  location    String?
  occurredAt  DateTime @default(now())
  source      String   @default("MANUAL")
  externalCode String?
  externalEventId String?
  metadata    Json?
  createdAt   DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([occurredAt])
  @@unique([shipmentId, externalEventId])
}

model Occurrence {
  id             String           @id @default(cuid())
  organizationId String
  protocol       String
  type           OccurrenceType
  status         OccurrenceStatus @default(OPEN)
  priority       TaskPriority     @default(MEDIUM)
  contactId      String?
  companyId      String?
  orderId        String?
  ownerId        String?
  description    String?
  value          Decimal?         @db.Decimal(14, 2)
  dueAt          DateTime?
  resolution     String?
  products       Json?
  createdById    String?
  updatedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization Organization           @relation(fields: [organizationId], references: [id])
  contact      Contact?               @relation(fields: [contactId], references: [id])
  company      Company?               @relation(fields: [companyId], references: [id])
  order        Order?                 @relation(fields: [orderId], references: [id])
  owner        User?                  @relation("OccurrenceOwner", fields: [ownerId], references: [id])
  attachments  OccurrenceAttachment[]
  tasks        Task[]
  activities   Activity[]
  notes        Note[]

  @@unique([organizationId, protocol])
  @@index([organizationId])
  @@index([status])
  @@index([contactId])
  @@index([orderId])
  @@index([createdAt])
}

model OccurrenceAttachment {
  id           String   @id @default(cuid())
  occurrenceId String
  fileName     String
  mimeType     String?
  url          String
  kind         String   @default("file")
  createdAt    DateTime @default(now())

  occurrence Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@index([occurrenceId])
}

model Campaign {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  source         String?
  medium         String?
  channel        String?
  status         String    @default("ACTIVE")
  budget         Decimal?  @db.Decimal(14, 2)
  startsAt       DateTime?
  endsAt         DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization               Organization                @relation(fields: [organizationId], references: [id])
  attributions               Attribution[]
  pipelineChannelConnections PipelineChannelConnection[]

  @@index([organizationId])
  @@index([source])
}

model Attribution {
  id             String   @id @default(cuid())
  organizationId String
  contactId      String?
  orderId        String?
  campaignId     String?
  source         String?
  medium         String?
  campaign       String?
  content        String?
  term           String?
  adSet          String?
  ad             String?
  creative       String?
  page           String?
  form           String?
  groupName      String?
  live           String?
  coupon         String?
  influencer     String?
  channel        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  contact      Contact?     @relation(fields: [contactId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id])
  campaignRef  Campaign?    @relation(fields: [campaignId], references: [id])

  @@index([organizationId])
  @@index([contactId])
  @@index([orderId])
  @@index([source])
}

model Automation {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         AutomationStatus @default(DRAFT)
  triggerType    String
  config         Json?
  createdById    String?
  updatedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id])
  nodes        AutomationNode[]
  edges        AutomationEdge[]
  executions   AutomationExecution[]

  @@index([organizationId])
  @@index([status])
}

model AutomationNode {
  id           String  @id @default(cuid())
  automationId String
  type         String
  label        String?
  config       Json?
  positionX    Float   @default(0)
  positionY    Float   @default(0)

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

model AutomationEdge {
  id           String  @id @default(cuid())
  automationId String
  sourceNodeId String
  targetNodeId String
  label        String?
  condition    Json?

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

model AutomationExecution {
  id           String    @id @default(cuid())
  automationId String
  status       String    @default("RUNNING")
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  context      Json?
  error        String?

  automation Automation               @relation(fields: [automationId], references: [id], onDelete: Cascade)
  logs       AutomationExecutionLog[]

  @@index([automationId])
  @@index([startedAt])
}

model AutomationExecutionLog {
  id          String   @id @default(cuid())
  executionId String
  nodeId      String?
  level       String   @default("info")
  message     String
  data        Json?
  createdAt   DateTime @default(now())

  execution AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  title          String
  body           String?
  href           String?
  entityType     String?
  entityId       String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model SavedView {
  id             String     @id @default(cuid())
  organizationId String
  userId         String?
  name           String
  entityType     EntityType
  filters        Json
  columns        Json?
  isShared       Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([entityType])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
