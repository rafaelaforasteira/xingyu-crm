# Xingyu CRM — Environment variables (example)
# Copy to .env and adjust. Never commit real secrets.

# Application
NODE_ENV=development
DEMO_MODE=true
DEMO_USER_ID=demo-admin
TZ=America/Sao_Paulo

# Database (PostgreSQL)
DATABASE_URL=postgresql://xingyu:xingyu@localhost:5432/xingyu_crm?schema=public
POSTGRES_USER=xingyu
POSTGRES_PASSWORD=xingyu
POSTGRES_DB=xingyu_crm
POSTGRES_PORT=5432

# Redis (optional — in-memory fallback when unavailable)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# API
API_PORT=3333
API_HOST=0.0.0.0
API_URL=http://localhost:3333
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=200

# Web
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# File uploads
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=./uploads

# Integrations (leave empty — adapters use mock/demo mode)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
META_ADS_ACCESS_TOKEN=
GOOGLE_ANALYTICS_MEASUREMENT_ID=
WEBHOOK_SECRET=

# Swagger
SWAGGER_ENABLED=true
