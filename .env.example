# Xingyu CRM — Environment variables (example)
# Copy to .env and adjust. Never commit real secrets.

# Application
NODE_ENV=development
DEMO_MODE=true
DEMO_USER_ID=demo-admin
TZ=America/Sao_Paulo

# Database (PostgreSQL)
DATABASE_URL=postgresql://xingyu:xingyu@localhost:5432/xingyu_crm?schema=public
POSTGRES_USER=xingyu
POSTGRES_PASSWORD=xingyu
POSTGRES_DB=xingyu_crm
POSTGRES_PORT=5432

# Redis (optional — in-memory fallback when unavailable)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# API
API_PORT=3333
WEB_PORT=3000
API_HOST=0.0.0.0
API_URL=http://localhost:3333
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=200

# Authentication (homologation foundation)
# Generate strong unique secrets; never reuse between access and refresh.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_DOMAIN=
ADMIN_EMAIL=admin@xingyu.local
ADMIN_INITIAL_PASSWORD=ChangeMeNow123!

# Web
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_CORE_OPERATION_MODE=true
NEXT_PUBLIC_BETA_SINGLE_PIPELINE_MODE=true
NEXT_PUBLIC_BETA_PIPELINE_ID=pipe-novos

# File uploads
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=./uploads

# Integrations (leave empty — adapters use mock/demo mode)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Evolution API (server-side only — never expose to the frontend)
CONNECTION_PROVIDER=fake
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

INSTAGRAM_ACCESS_TOKEN=
META_ADS_ACCESS_TOKEN=
GOOGLE_ANALYTICS_MEASUREMENT_ID=
WEBHOOK_SECRET=

# Swagger (explicitly enable for local docs; leave false in locked-down environments)
SWAGGER_ENABLED=true

# Load tests — localhost only. Never point these at production.
LOAD_BASE_URL=http://localhost:3333/api
LOAD_TEST_EMAIL=
LOAD_TEST_PASSWORD=
